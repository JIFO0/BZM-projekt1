# Copy to .env in apps/mobile (or the repo root) and fill in a real key.
# Never commit the real key. The app reads EXPO_PUBLIC_MAPY_API_KEY.
# A key shipped inside a client binary can be extracted. Restrict it in the
# Mapy.com project settings. Production should put the key behind a proxy.
# Docs: https://developer.mapy.com/my-account/project-and-api-keys/
# Env vars: https://docs.expo.dev/guides/environment-variables/
EXPO_PUBLIC_MAPY_API_KEY=replace-with-mapy-api-key
