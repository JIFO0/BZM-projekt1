# ==============================================================================
# Production Dockerfile for Kraków bez barier API Server (Hono)
# ==============================================================================
FROM node:26

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000
ENV HOST=0.0.0.0

# Copy workspace metadata and dependency manifests
COPY package.json package-lock.json tsconfig.base.json tsconfig.json ./
COPY packages/core/package.json ./packages/core/
COPY packages/cli/package.json ./packages/cli/

# Install dependencies (cached until package manifests change)
RUN npm ci --include=dev

# Copy application source and assets
COPY packages/core/ ./packages/core/
COPY packages/cli/ ./packages/cli/
COPY cities/ ./cities/
COPY fixtures/ ./fixtures/

EXPOSE 3000

CMD ["npm", "run", "server", "-w", "@krakow-bez-barier/cli"]
