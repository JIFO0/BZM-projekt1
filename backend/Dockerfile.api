# ==============================================================================
# Production Dockerfile for Kraków bez barier API Server (Hono)
# ==============================================================================
FROM node:26

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000
ENV HOST=0.0.0.0

# Copy workspace metadata and configs
COPY package.json package-lock.json tsconfig.base.json tsconfig.json ./
COPY packages/core/ ./packages/core/
COPY packages/cli/ ./packages/cli/
COPY cities/ ./cities/
COPY fixtures/ ./fixtures/

# Install dependencies (including tsx runtime runner in devDependencies)
RUN npm ci --include=dev --verbose

EXPOSE 3000

CMD ["npm", "run", "server", "-w", "@krakow-bez-barier/cli"]
