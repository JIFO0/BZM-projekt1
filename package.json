{
  "name": "krakow-bez-barier",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm run start -w krakow-bez-barier-mobile",
    "start:clean": "npm run start:clean -w krakow-bez-barier-mobile",
    "cli": "npm run start -w @krakow-bez-barier/cli --",
    "server": "npm run server -w @krakow-bez-barier/cli",
    "datagen": "npm run datagen -w @krakow-bez-barier/cli",
    "download-tiles": "npm run cli -- download-tiles",
    "build-snapshot": "npm run build-snapshot -w @krakow-bez-barier/cli",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint -w krakow-bez-barier-mobile",
    "test": "jest --colors=false",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "export:harmony-web": "npm run export:harmony-web -w krakow-bez-barier-mobile",
    "build:apk": "npm run build:apk -w krakow-bez-barier-mobile"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^26.6.4",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.2"
  }
}
