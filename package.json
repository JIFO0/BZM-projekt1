{
  "name": "krakow-bez-barier",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm run start -w krakow-bez-barier-mobile",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint -w krakow-bez-barier-mobile",
    "test": "jest --colors=false",
    "verify": "npm run typecheck && npm run lint && npm run test"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.1",
    "typescript": "~5.9.2"
  }
}
